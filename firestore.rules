rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
    }

    // User profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    // Memes collection
    match /memes/{memeId} {
      // Any user can read public memes; owner can read their own
      allow get: if resource.data.isPublic == true || (isSignedIn() && isOwner(resource.data.userId));
      
      // List enforced by security query
      allow list: if resource.data.isPublic == true || (isSignedIn() && resource.data.userId == request.auth.uid);

      // Authenticated users can create memes with their own userId
      allow create: if isSignedIn() 
        && incoming().userId == request.auth.uid
        && incoming().imageUrl is string
        && incoming().imageUrl.size() <= 6000000;

      // Owner can update their meme, or any signed-in user can increment likesCount
      allow update: if (isSignedIn() && isOwner(existing().userId))
        || (isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['likesCount']));

      // Only owner can delete their meme
      allow delete: if isSignedIn() && isOwner(existing().userId);
    }
  }
}
